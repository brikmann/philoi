{
  "enabledPlugins": {
    "expo@claude-plugins-official": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/git-writer-lease.sh\"",
            "timeout": 10,
            "statusMessage": "Checking git writer lease"
          }
        ]
      }
    ]
  }
}
