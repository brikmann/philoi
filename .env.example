# Supabase project settings (Project Settings → API)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# PostHog project API key (posthog.com → Project Settings → API Keys). Without this,
# events still write to Supabase's `events` table, but nothing reaches a PostHog dashboard.
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Optional — only needed once RevenueCat billing is wired up (see src/lib/billing.ts)
REVENUECAT_IOS_KEY=
REVENUECAT_ANDROID_KEY=

# Native Google Sign-In (src/lib/auth/providers.ts). GOOGLE_WEB_CLIENT_ID MUST be the exact
# Client ID configured in Supabase Auth > Providers > Google. GOOGLE_IOS_CLIENT_ID is a
# separate "iOS" type OAuth client (bundle id com.philoi.app) from the same Google Cloud
# project. Android needs no client id here — just its OAuth client's SHA-1 registered in
# Google Cloud Console (Credentials > OAuth client ID > Android, package com.philoi.app).
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# Apple Developer Team ID — OPTIONAL OVERRIDE ONLY.
# The real value (WA73L5743X) is committed in app.config.ts, because a Team ID is not a secret and
# an unset env var would silently misconfigure the Live Activity widget target. Set this only to
# build under a DIFFERENT Apple team.
APPLE_TEAM_ID=
