# Supabase project settings (Project Settings → API)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# PostHog project API key (posthog.com → Project Settings → API Keys). Without this,
# events still write to Supabase's `events` table, but nothing reaches a PostHog dashboard.
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Optional — only needed once RevenueCat billing is wired up (see src/lib/billing.ts)
REVENUECAT_IOS_KEY=
REVENUECAT_ANDROID_KEY=
